# ==========================================================================
# Andes Petrolera — variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se versiona (está en .gitignore).
# ==========================================================================

# --- PostHog: integración del sitio (obligatorio) -------------------------
# Project API Key del proyecto. Es pública: viaja al navegador.
# PostHog > Settings > Project > Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Host de ingesta según la región del proyecto:
#   EE.UU.  https://us.i.posthog.com
#   Europa  https://eu.i.posthog.com
#   Self-hosted: la URL de la instancia
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Poné "false" para desactivar la analítica sin tocar el código.
NEXT_PUBLIC_ANALITICA_HABILITADA=true


# --- PostHog: script de carga de datos de demo ----------------------------
# El script de seed usa la misma Project API Key de arriba. No necesita más
# credenciales para cargar eventos históricos.

# Días hacia atrás a generar (por defecto 35, suficiente para que el reporte
# semanal muestre la semana actual y varias semanas de comparación).
SEED_DIAS=35

# Cantidad de personas distintas a simular.
SEED_VISITANTES=900


# --- PostHog: creación automática del dashboard semanal (opcional) --------
# Sólo hace falta si querés que el script cree el dashboard y los insights.
# PostHog > Settings > Personal API Keys > crear una con los scopes:
#   insight:write, dashboard:write, query:read
POSTHOG_PERSONAL_API_KEY=
# PostHog > Settings > Project > Project ID (es un número)
POSTHOG_PROJECT_ID=
